{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Huffman User Stop Event",
  "description": "Synthetic lifecycle event schema; not an authentication mechanism or deployed service.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "occurred_at", "tenant_id", "actor_principal_id", "task_id", "scope", "requested_action", "enforcement_state", "result"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "occurred_at": {"type": "string", "format": "date-time"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "actor_principal_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope": {"enum": ["task", "user_authority_graph", "integration"]},
    "requested_action": {"enum": ["stop", "pause", "revoke", "disconnect", "resume"]},
    "enforcement_state": {"enum": ["received", "dispatch_blocked", "grants_revoked", "work_contained", "complete_with_limitations", "not_verified"]},
    "result": {"enum": ["accepted", "effective", "partial", "denied", "failed", "not_verified"]},
    "residual_risks": {"type": "array", "items": {"type": "string", "maxLength": 1000}, "maxItems": 50}
  }
}